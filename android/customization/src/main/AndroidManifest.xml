<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <package android:name="me.weishu.kernelsu" />
        <package android:name="org.matrix.vector.manager" />
        <package android:name="org.lsposed.manager" />
    </queries>
    <application>
        <receiver android:name="com.nodecockpit.customization.NotificationUndoSampleReceiver" android:exported="false" />
        <provider android:name="com.nodecockpit.customization.HealthProvider"
            android:authorities="${applicationId}.customization.health"
            android:exported="true" android:directBootAware="true" />
        <receiver android:name="com.nodecockpit.customization.RecoveryReceiver"
            android:permission="android.permission.DUMP"
            android:exported="true" android:directBootAware="true">
            <intent-filter>
                <action android:name="com.nodecockpit.customization.DISABLE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name="com.nodecockpit.customization.BootRecoveryJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" android:directBootAware="true" />
    </application>
</manifest>
